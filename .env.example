# Copy to .env and fill in.
#
# ---- Option A: hosted Postgres (Neon, Supabase, RDS, …) ----
# Both Neon and Supabase let Prisma create its own shadow database, so
# SHADOW_DATABASE_URL can stay commented out.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shadow?sslmode=require"
#
# ---- Option B: local Postgres via Homebrew (macOS) ----
# Fastest for development — a hosted database in another region costs
# ~250ms per query, and a page makes dozens.
#   brew install postgresql@17 && brew services start postgresql@17
#   createdb aadrique
# DATABASE_URL=postgresql://<your-mac-username>@localhost:5432/aadrique
# DIRECT_DATABASE_URL=postgresql://<your-mac-username>@localhost:5432/aadrique
# then: npm run db:deploy && npm run db:seed
#
# ---- Option C: local Prisma Postgres, no install ----
# Needs Node 22+. Start it with:
#   npx prisma dev -n aadrique -d
# then copy the TCP url it prints (and the shadow port, which is TCP port + 1):
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ---- AI (optional) ----
# Without a key the product still works: AI surfaces are assembled
# deterministically from the patient's own records, so nothing is generated
# and nothing can be invented. Set a key to have Claude write them instead,
# with every citation checked back against the record.
# ANTHROPIC_API_KEY="sk-ant-..."

# ---- Patient portal ----
# Patients sign in at /portal/<organisation-slug> with a code sent to their
# mobile. For real SMS in India, add an SMS template with key portal_code and
# its MSG91 DLT flow id (the flow's variable named "code").
# With no gateway connected, codes can be shown on screen for a demo — never
# set this on a real deployment:
# PORTAL_DEMO_CODES=true

# ---- Clinic time zone ----
# "Today" — today's queue, today's appointments — is the server's local day.
# Run the server in the clinic's time zone, or the day turns over at the
# wrong hour (a UTC server starts an Indian clinic's day at 5:30 am).
# TZ=Asia/Kolkata

# ---- Public address ----
# Where patients reach the app. Lets a token message carry {{statusLink}}, the
# patient's live token page. Without it the variable is not offered, and a
# template that uses it is held back rather than sent with a broken link.
# APP_URL=https://opd.example.org

# ---- Auth ----
# Required by `next start` outside Vercel (which sets it for you): Auth.js
# refuses requests for a host it has not been told to trust.
# AUTH_TRUST_HOST=true

# ---- Messaging gateways ----
# Each organisation's Integration row (Admin → Integrations) names its
# credential as env://VARIABLE_NAME; set that variable here. Until a channel's
# integration is connected and its credential resolves, messages go through
# the simulated gateway and are labelled "simulated".
#
# WhatsApp (Meta Cloud API) — integration config: phoneNumberId, wabaId
# WHATSAPP_ACCESS_TOKEN=
# Delivery receipts and patient replies: point Meta's webhook at
# https://<APP_URL>/api/webhooks/whatsapp with these two:
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
#
# SMS (MSG91) — integration config: senderId. Every SMS template needs its
# DLT-approved MSG91 flow id in the template's provider template id.
# MSG91_AUTH_KEY=
#
# Email (Resend) — integration config: fromAddress (a verified domain)
# RESEND_API_KEY=
# Delivery events: point a Resend webhook at
# https://<APP_URL>/api/webhooks/resend with its signing secret:
# RESEND_WEBHOOK_SECRET=

# ---- Scheduled jobs ----
# The workflow engine parks a run on a WAIT step; this secret authorizes the
# scheduler that resumes them. Without it POST /api/jobs/workflows refuses to
# run at all rather than defaulting to open.
# CRON_SECRET="a-long-random-string"
